rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Cada utilizador só lê e escreve os seus próprios dados (perfil e viagens)
    match /users/{userId}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Viagens partilhadas por código curto (ex: AALX40)
    match /sharedTrips/{code} {
      allow get: if request.auth != null;          // abrir pelo código
      allow list: if false;                         // impede listar/enumerar códigos
      allow create: if request.auth != null && request.resource.data.ownerId == request.auth.uid;
      allow update, delete: if request.auth != null && resource.data.ownerId == request.auth.uid;
    }
  }
}
