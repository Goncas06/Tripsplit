rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Cada utilizador só lê e escreve os seus próprios dados (perfil e viagens)
    match /users/{userId}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Viagens partilhadas por código curto (ex: AALX40), válidas por 30 dias
    match /sharedTrips/{code} {
      // Só os campos esperados, o dono é quem escreve e a validade não passa de ~30 dias
      function dadosValidos() {
        let d = request.resource.data;
        return d.keys().hasOnly(['ownerId', 'trip', 'updatedAt', 'expiresAt'])
          && d.ownerId == request.auth.uid
          && d.trip is map
          && d.updatedAt is int
          && d.expiresAt is timestamp
          && d.expiresAt <= request.time + duration.value(31, 'd');
      }

      // Abrir pelo código, enquanto não expirar (um código inexistente devolve "não existe")
      allow get: if request.auth != null
        && (resource == null || resource.data.expiresAt > request.time);
      // Impede listar/enumerar todos os códigos
      allow list: if false;
      // Códigos só no formato da app: 6 caracteres sem 0/O, 1/I/L
      allow create: if request.auth != null
        && code.matches('^[A-HJKMNP-Z2-9]{6}$')
        && dadosValidos();
      // Só o dono altera (sem poder passar a viagem a outra pessoa) ou apaga
      allow update: if request.auth != null
        && resource.data.ownerId == request.auth.uid
        && dadosValidos();
      allow delete: if request.auth != null && resource.data.ownerId == request.auth.uid;
    }
  }
}
