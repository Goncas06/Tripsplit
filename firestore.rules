rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Perfil de cada utilizador e viagens no formato antigo (migradas automaticamente pela app)
    match /users/{userId}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // ── Viagens partilhadas: um documento por viagem, visível a todos os membros ──
    match /trips/{tripId} {
      function signedIn() { return request.auth != null; }
      function isMember() { return signedIn() && request.auth.uid in resource.data.members; }
      function novo() { return request.resource.data; }

      // Ler (incluindo a lista "as minhas viagens", que filtra por members)
      allow read: if isMember();

      // Criar: quem cria é o dono e o único membro
      allow create: if signedIn()
        && novo().ownerId == request.auth.uid
        && novo().members == [request.auth.uid];

      // A amizade entre o utilizador e `outro` foi aceite?
      function amigoDe(outro) {
        let eu = request.auth.uid;
        let id = eu < outro ? eu + '_' + outro : outro + '_' + eu;
        return get(/databases/$(database)/documents/friendships/$(id)).data.status == 'accepted';
      }

      // Membros editam a viagem, sem mudar o dono. Nos membros podem: deixar igual,
      // sair (remover-se a si) ou convidar um amigo (acrescentar uma pessoa com amizade aceite)
      allow update: if isMember()
        && novo().ownerId == resource.data.ownerId
        && (novo().members == resource.data.members
            || novo().members == resource.data.members.removeAll([request.auth.uid])
            || (novo().members.size() == resource.data.members.size() + 1
                && novo().members.hasAll(resource.data.members)
                && amigoDe(novo().members[novo().members.size() - 1])));

      // Juntar-se com código: quem não é membro só pode acrescentar-se a si próprio,
      // indicando o código atual da viagem, e só enquanto o código for válido
      allow update: if signedIn()
        && !(request.auth.uid in resource.data.members)
        && novo().diff(resource.data).affectedKeys().hasOnly(['members', 'joinCode'])
        && novo().members == resource.data.members.concat([request.auth.uid])
        && novo().joinCode == resource.data.shareCode
        && resource.data.shareExpiresAt > request.time;

      // Só o dono elimina a viagem (para todos)
      allow delete: if signedIn() && resource.data.ownerId == request.auth.uid;
    }

    // ── Códigos de amigo (ex: K7XB9Q) → utilizador ──
    match /friendCodes/{code} {
      allow get: if request.auth != null;
      allow list: if false;
      allow create: if request.auth != null
        && code.matches('^[A-HJKMNP-Z2-9]{6}$')
        && request.resource.data.keys().hasOnly(['uid', 'name'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.name is string
        && request.resource.data.name.size() <= 50;
      allow update: if request.auth != null
        && resource.data.uid == request.auth.uid
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.keys().hasOnly(['uid', 'name']);
      allow delete: if request.auth != null && resource.data.uid == request.auth.uid;
    }

    // ── Pedidos de amizade e amizades: id = uids por ordem, "uidA_uidB" ──
    match /friendships/{pairId} {
      function eu() { return request.auth.uid; }

      // Cada um vê os seus pedidos e amizades (a lista filtra por users)
      allow read: if request.auth != null && eu() in resource.data.users;

      // Enviar pedido: em nome próprio, para outra pessoa, sempre "pending"
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(['users', 'from', 'to', 'names', 'status', 'createdAt'])
        && request.resource.data.from == eu()
        && request.resource.data.to is string
        && request.resource.data.to != eu()
        && request.resource.data.users.size() == 2
        && request.resource.data.users.hasAll([eu(), request.resource.data.to])
        && pairId == (eu() < request.resource.data.to
                        ? eu() + '_' + request.resource.data.to
                        : request.resource.data.to + '_' + eu())
        && request.resource.data.status == 'pending';

      // Só quem recebeu o pedido o aceita (e só muda o estado)
      allow update: if request.auth != null
        && resource.data.to == eu()
        && resource.data.status == 'pending'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
        && request.resource.data.status == 'accepted';

      // Recusar, cancelar ou remover amigo: qualquer um dos dois
      allow delete: if request.auth != null && eu() in resource.data.users;
    }

    // ── Códigos de partilha (ex: K7XB9Q) → viagem, válidos 30 dias ──
    match /sharedTrips/{code} {
      function membroDaViagem(tripId) {
        return request.auth.uid in get(/databases/$(database)/documents/trips/$(tripId)).data.members;
      }
      function dadosValidos() {
        let d = request.resource.data;
        return d.keys().hasOnly(['tripId', 'ownerId', 'expiresAt', 'updatedAt'])
          && d.ownerId == request.auth.uid
          && d.tripId is string
          && d.updatedAt is int
          && d.expiresAt is timestamp
          && d.expiresAt <= request.time + duration.value(31, 'd')
          && membroDaViagem(d.tripId);
      }

      // Abrir pelo código enquanto não expirar (um código inexistente devolve "não existe")
      allow get: if request.auth != null
        && (resource == null || resource.data.expiresAt > request.time);
      // Impede listar/enumerar todos os códigos
      allow list: if false;
      // Códigos só no formato da app: 6 caracteres sem 0/O, 1/I/L; quem cria tem de ser membro
      allow create: if request.auth != null
        && code.matches('^[A-HJKMNP-Z2-9]{6}$')
        && dadosValidos();
      // Qualquer membro da viagem renova ou apaga o código (sem o apontar para outra viagem)
      allow update: if request.auth != null
        && dadosValidos()
        && request.resource.data.tripId == resource.data.tripId;
      allow delete: if request.auth != null
        && resource.data.keys().hasAll(['tripId'])
        && membroDaViagem(resource.data.tripId);
    }
  }
}
